<!DOCTYPE html>
<html lang="en">
<% include global/header.ejs %>
<style>
  #insights-body .insight-toolbar { margin-top: 20px; }
  #insights-body .insight-controls { text-align: right; }
  #insights-body .insight-controls .btn-group { margin-right: 4px; }
  #insights-body .insight-custom-form .form-group { margin-bottom: 0; }
  #insights-body #insight-chart { min-height: 300px; position: relative; }
  #insights-body .insight-chart-point { fill: #337ab7; stroke: #fff; stroke-width: 2; cursor: pointer; outline: none; }
  #insights-body .insight-chart-point:hover,
  #insights-body .insight-chart-point:focus { r: 7; stroke: #337ab7; }
  #insights-body .insight-chart-tooltip {
    position: absolute;
    display: none;
    z-index: 10;
    max-width: 240px;
    padding: 7px 10px;
    background: #333;
    color: #fff;
    border-radius: 4px;
    font-size: 12px;
    line-height: 1.4;
    pointer-events: none;
    box-shadow: 0 2px 6px rgba(0,0,0,.2);
  }
  #insights-body .protocol-list { padding: 5px 0 10px; }
  #insights-body .protocol-item { padding: 12px 15px; border-bottom: 1px solid #eee; }
  #insights-body .protocol-item:last-child { border-bottom: 0; }
  #insights-body .protocol-name { font-weight: 600; margin-bottom: 5px; }
  #insights-body .protocol-meta { float: right; color: #777; font-size: 12px; }
  #insights-body .protocol-track { height: 16px; background: #f1f1f1; border-radius: 3px; overflow: hidden; }
  #insights-body .protocol-bar { display: block; height: 100%; min-width: 2px; background: #337ab7; border-radius: 3px; }
  #insights-body .protocol-count { margin-top: 4px; font-size: 12px; color: #777; }
  #insights-body .heatmap-wrap { overflow-x: auto; padding: 10px 15px 15px; }
  #insights-body .heatmap { min-width: 680px; display: grid; grid-template-columns: 70px repeat(24, minmax(20px, 1fr)); gap: 3px; align-items: center; }
  #insights-body .heatmap-label { font-size: 11px; color: #777; }
  #insights-body .heatmap-hour { text-align: center; font-size: 10px; color: #777; }
  #insights-body .heatmap-cell { height: 22px; border-radius: 3px; background: #f1f1f1; position: relative; }
  #insights-body .heatmap-cell[data-level="1"] { background: #d9edf7; }
  #insights-body .heatmap-cell[data-level="2"] { background: #9acfea; }
  #insights-body .heatmap-cell[data-level="3"] { background: #5bc0de; }
  #insights-body .heatmap-cell[data-level="4"] { background: #337ab7; }
  #insights-body .heatmap-cell:hover::after { content: attr(aria-label); position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); white-space: nowrap; z-index: 5; background: #333; color: #fff; padding: 4px 7px; border-radius: 3px; font-size: 11px; }
  #insights-body .heatmap-legend { margin-top: 8px; text-align: right; font-size: 11px; color: #777; }
  #insights-body .heatmap-swatch { display: inline-block; width: 14px; height: 14px; vertical-align: middle; margin-left: 4px; border-radius: 2px; }
  #insights-body .heatmap-swatch.level-0 { background: #f1f1f1; }
  #insights-body .heatmap-swatch.level-1 { background: #d9edf7; }
  #insights-body .heatmap-swatch.level-2 { background: #9acfea; }
  #insights-body .heatmap-swatch.level-3 { background: #5bc0de; }
  #insights-body .heatmap-swatch.level-4 { background: #337ab7; }
  #insights-body .insight-live-pulse { border-left: 4px solid #777; }
  #insights-body .insight-live-pulse.active { border-left-color: #3c763d; }
  #insights-body .insight-live-pulse.quiet { border-left-color: #f0ad4e; }
  #insights-body .insight-live-pulse.inactive { border-left-color: #999; }
  #insights-body .insight-live-pulse-label { font-size: 16px; font-weight: 600; }
  #insights-body .insight-live-pulse-count { font-size: 30px; font-weight: 600; margin: 4px 0; }
  #insights-body .insight-status-row { display: flex; }
  #insights-body .insight-status-row > [class*="col-"] { display: flex; }
  #insights-body .insight-status-row .panel { width: 100%; margin-bottom: 20px; }
  #insights-body .insight-status-row .panel-body { min-height: 150px; display: flex; flex-direction: column; justify-content: center; }
  #insights-body .insight-anomaly { border-left: 4px solid #999; }
  #insights-body .insight-anomaly.normal { border-left-color: #3c763d; }
  #insights-body .insight-anomaly.spike { border-left-color: #a94442; }
  #insights-body .insight-anomaly.drop { border-left-color: #f0ad4e; }
  #insights-body .insight-anomaly-label { font-size: 16px; font-weight: 600; }
  #insights-body .insight-anomaly-message { font-size: 20px; font-weight: 600; margin: 5px 0; }
  #insights-body .insight-table-track { height: 5px; margin-top: 5px; background: #eee; border-radius: 3px; overflow: hidden; }
  #insights-body .insight-table-bar { display: block; height: 100%; background: #777; border-radius: 3px; min-width: 0; }
  #insights-body .insight-table-percent { font-size: 11px; color: #777; margin-top: 2px; }
  #insights-body .insight-trend-value { font-size: 14px; font-weight: 600; white-space: nowrap; }
  #insights-body .insight-trend-value.up { color: #3c763d; }
  #insights-body .insight-trend-value.down { color: #a94442; }
  #insights-body .insight-trend-value.flat { color: #777; }
  #insights-body .insight-trend-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #eee; }
  #insights-body .insight-trend-row strong { font-size: 15px; }
  #insights-body .insight-trend-row:last-child { border-bottom: 0; }
  #insights-body .insight-trend-hero { padding: 8px 0 4px; }
  #insights-body .insight-trend-hero #insight-trend-period { margin-top: 5px; margin-bottom: 5px; font-size: 30px; }
  #insights-body .insight-trend-section-title { font-size: 15px; font-weight: 600; }
  #insights-body .peak-time { font-size: 22px; font-weight: 600; }
  #insights-body .peak-value { font-size: 28px; font-weight: 600; }
  #insights-body .peak-meta { color: #777; font-size: 12px; }
  @media (max-width: 767px) {
    #insights-body .insight-toolbar { margin-top: 10px; }
    #insights-body .insight-title { float: none !important; }
    #insights-body .insight-controls { float: none !important; text-align: left; margin-top: 15px; }
    #insights-body .insight-controls .btn-group { display: inline-flex; margin-bottom: 5px; }
    #insights-body .insight-controls .btn { padding-left: 10px; padding-right: 10px; }
    #insights-body .insight-custom-form .form-group { display: block; margin: 0 0 10px 0 !important; }
    #insights-body .insight-custom-form .form-control { width: 100%; }
    #insights-body .insight-custom-form .btn { margin-left: 0 !important; width: 100%; }
    #insights-body #insight-chart { min-height: 240px; }
    #insights-body #insight-chart svg { min-width: 0 !important; }
    #insights-body .table-responsive { border: 0; margin-bottom: 0; }
  }
</style>
</head>
<body id="insights-body">
<% include global/menu.ejs %>

<div id="content" class="container-fluid insight-toolbar">
  <div class="row">
    <div class="col-xs-12">
      <div class="clearfix">
        <div class="pull-left insight-title">
          <h2><i class="fa fa-line-chart"></i> PagerMon Insights</h2>
          <p class="text-muted">Message activity for the selected period.</p>
        </div>
        <div class="pull-right insight-controls">
          <div class="btn-group" role="group" aria-label="Insights date range">
            <button type="button" class="btn btn-default insight-range" data-days="1">24 hours</button>
            <button type="button" class="btn btn-default insight-range" data-days="7">7 days</button>
            <button type="button" class="btn btn-default insight-range" data-days="30">30 days</button>
          </div>
          <button type="button" class="btn btn-default" id="insight-custom-toggle">Custom</button>
        </div>
      </div>
      <div id="insight-custom" class="well well-sm" style="display:none; margin-top:15px;">
        <form class="form-inline insight-custom-form" id="insight-custom-form">
          <div class="form-group"><label for="insight-start" style="margin-right:6px;">From</label><input type="datetime-local" class="form-control" id="insight-start"></div>
          <div class="form-group" style="margin-left:10px;"><label for="insight-end" style="margin-right:6px;">To</label><input type="datetime-local" class="form-control" id="insight-end"></div>
          <button type="submit" class="btn btn-primary" style="margin-left:10px;">Apply</button>
        </form>
      </div>
      <hr>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-6 col-md-3"><div class="panel panel-default"><div class="panel-body text-center"><div class="text-muted">Messages</div><div id="insight-messages" class="h2">—</div></div></div></div>
    <div class="col-sm-6 col-md-3"><div class="panel panel-default"><div class="panel-body text-center"><div class="text-muted">Unique addresses</div><div id="insight-addresses" class="h2">—</div></div></div></div>
    <div class="col-sm-6 col-md-3"><div class="panel panel-default"><div class="panel-body text-center"><div class="text-muted">Unique capcodes</div><div id="insight-capcodes" class="h2">—</div></div></div></div>
    <div class="col-sm-6 col-md-3"><div class="panel panel-default"><div class="panel-body text-center"><div class="text-muted">Top agency</div><div id="insight-source" class="h2">—</div></div></div></div>
  </div>

  <div class="row insight-status-row">
    <div class="col-sm-6">
      <div class="panel panel-default insight-live-pulse">
        <div class="panel-body text-center">
          <div id="insight-live-pulse-label" class="insight-live-pulse-label">⚪ Live Pulse</div>
          <div id="insight-live-pulse-count" class="insight-live-pulse-count">—</div>
          <div class="text-muted">messages in the last hour</div>
        </div>
      </div>
    </div>

    <div class="col-sm-6">
      <div class="panel panel-default insight-anomaly">
        <div class="panel-body text-center">
          <div id="insight-anomaly-label" class="insight-anomaly-label">⚪ Traffic Anomaly</div>
          <div id="insight-anomaly-message" class="insight-anomaly-message">Checking traffic patterns…</div>
          <div id="insight-anomaly-detail" class="text-muted"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default" id="insight-trend-panel">
        <div class="panel-heading"><strong>📈 Traffic Trend</strong></div>
        <div class="panel-body" aria-live="polite">
          <div class="text-center insight-trend-hero">
            <div id="insight-trend-period" class="h2">—</div>
            <div class="text-muted">Overall traffic compared with the previous period</div>
          </div>
          <hr>
          <div class="row">
            <div class="col-sm-6">
              <div class="insight-trend-section-title">🏢 Agency trends</div>
              <div id="insight-trend-agencies" style="margin-top:10px;">—</div>
            </div>
            <div class="col-sm-6">
              <div class="insight-trend-section-title">📡 Protocol trends</div>
              <div id="insight-trend-protocols" style="margin-top:10px;">—</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading"><strong>🔥 Peak Activity</strong></div>
        <div class="panel-body" aria-live="polite">
          <div class="row text-center">
            <div class="col-sm-4">
              <div class="text-muted">Busiest period</div>
              <div id="insight-peak-time" class="peak-time">—</div>
            </div>
            <div class="col-sm-4">
              <div class="text-muted">Peak messages</div>
              <div id="insight-peak-count" class="peak-value">—</div>
            </div>
            <div class="col-sm-4">
              <div class="text-muted">Average / hour</div>
              <div id="insight-average-hour" class="peak-value">—</div>
            </div>
          </div>
          <div class="text-center peak-meta" style="margin-top:8px;">Based on the selected Insights date range.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading"><strong>Messages over time</strong></div>
        <div class="panel-body"><div id="insight-chart" style="width:100%; min-height:300px; overflow:hidden;"></div></div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default insight-live-feed">
        <div class="panel-heading">
          <strong>⚡ Live Activity</strong>
          <span id="insight-live-feed-status" class="pull-right text-muted">Connecting…</span>
        </div>
        <div class="panel-body" style="padding:0;">
          <div id="insight-live-feed" aria-live="polite" aria-label="Live message activity">
            <div class="text-muted text-center" style="padding:20px;">Waiting for live messages…</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row" id="insight-message-detail" style="display:none;">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <strong>🔎 Messages in selected period</strong>
          <button type="button" class="btn btn-xs btn-default pull-right" id="insight-message-detail-close">Close</button>
        </div>
        <div class="panel-body">
          <div id="insight-message-detail-summary" class="text-muted" aria-live="polite"></div>
          <div id="insight-message-detail-content" style="margin-top:10px;" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading"><strong>Activity by day and hour</strong></div>
        <div class="heatmap-wrap">
          <div id="insight-heatmap" class="heatmap" role="img" aria-label="Message activity by day and hour"></div>
          <div class="heatmap-legend">Less <span class="heatmap-swatch level-0"></span><span class="heatmap-swatch level-1"></span><span class="heatmap-swatch level-2"></span><span class="heatmap-swatch level-3"></span><span class="heatmap-swatch level-4"></span> More</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12">
      <div class="panel panel-default">
        <div class="panel-heading"><strong>Messages by protocol</strong></div>
        <div id="insight-protocol-list" class="protocol-list" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-12 col-md-4"><div class="panel panel-default"><div class="panel-heading"><strong>Top addresses</strong></div><div class="table-responsive"><table class="table table-striped table-condensed"><thead><tr><th>Address</th><th class="text-right">Messages</th></tr></thead><tbody id="insight-address-table"></tbody></table></div></div></div>
    <div class="col-xs-12 col-md-4"><div class="panel panel-default"><div class="panel-heading"><strong>Top capcodes</strong></div><div class="table-responsive"><table class="table table-striped table-condensed"><thead><tr><th>Capcode</th><th class="text-right">Messages</th></tr></thead><tbody id="insight-capcode-table"></tbody></table></div></div></div>
    <div class="col-xs-12 col-md-4">
      <div class="panel panel-default">
        <div class="panel-heading"><strong>Top agencies</strong></div>
        <div class="panel-body">
          <div id="insight-agency-list" class="protocol-list" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="insight-error" class="alert alert-danger" style="display:none;"></div>
</div>

<script>
var insightDays = 1;
var insightCustomRange = null;

function insightRange() {
  if (insightCustomRange) return insightCustomRange;
  var end = Math.floor(Date.now() / 1000);
  return { start: end - (insightDays * 24 * 60 * 60), end: end };
}

function toDateTimeLocal(timestamp) {
  var date = new Date(timestamp * 1000);
  var pad = function (value) { return String(value).padStart(2, '0'); };
  return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) + 'T' + pad(date.getHours()) + ':' + pad(date.getMinutes());
}

function renderTrendValue(trend) {
  var percent = Number(trend.percent || 0);
  var direction = trend.direction === 'up' ? 'up' : (trend.direction === 'down' ? 'down' : 'flat');
  var arrow = direction === 'up' ? '↑' : (direction === 'down' ? '↓' : '→');
  var sign = percent > 0 ? '+' : '';
  var label = direction === 'up' ? 'Increase' : (direction === 'down' ? 'Decrease' : 'No change');
  return '<span class="insight-trend-value ' + direction + '" title="' + label + '">' +
    arrow + ' ' + sign + percent + '%</span>';
}

function renderTrendList(items, field) {
  if (!items || !items.length) {
    return '<span class="text-muted">No trend data</span>';
  }

  return items.slice(0, 5).map(function (item) {
    var name = $('<div>').text(item[field] || 'UNKNOWN').html();
    return '<div class="insight-trend-row">' +
      '<strong>' + name + '</strong>' +
      renderTrendValue(item) +
      '</div>';
  }).join('');
}

function renderTrends(trends) {
  if (!trends || !trends.period) {
    $('#insight-trend-period').text('No trend data');
    $('#insight-trend-agencies').html('<span class="text-muted">No trend data</span>');
    $('#insight-trend-protocols').html('<span class="text-muted">No trend data</span>');
    return;
  }

  $('#insight-trend-period').html(renderTrendValue(trends.period));
  $('#insight-trend-agencies').html(renderTrendList(trends.agencies, 'agency'));
  $('#insight-trend-protocols').html(renderTrendList(trends.protocols, 'protocol'));
}

function renderInsightChart(activity) {
  var container = document.getElementById('insight-chart');
  if (!activity || !activity.length) { container.innerHTML = '<p class="text-muted">No message activity for this period.</p>'; return; }
  var width = Math.max(container.clientWidth || 800, 600), height = 300, padding = { top: 20, right: 20, bottom: 45, left: 55 }, plotWidth = width - padding.left - padding.right, plotHeight = height - padding.top - padding.bottom;
  var max = Math.max.apply(null, activity.map(function (point) { return Number(point.count) || 0; }));
  if (max < 1) max = 1;
  function x(index) { return padding.left + (activity.length === 1 ? plotWidth / 2 : (index / (activity.length - 1)) * plotWidth); }
  function y(value) { return padding.top + plotHeight - ((Number(value) || 0) / max) * plotHeight; }
  var points = activity.map(function (point, index) { return x(index) + ',' + y(point.count); }).join(' '), labels = '', pointMarkup = '', labelCount = Math.min(6, activity.length);
  for (var i = 0; i < labelCount; i++) { var index = labelCount === 1 ? 0 : Math.round(i * (activity.length - 1) / (labelCount - 1)); var date = new Date(Number(activity[index].timestamp) * 1000); var label = date.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }); labels += '<text x="' + x(index) + '" y="' + (height - 12) + '" text-anchor="middle" font-size="11" fill="#777">' + label + '</text>'; }
  activity.forEach(function (point, index) {
    var date = new Date(Number(point.timestamp) * 1000);
    var count = Number(point.count) || 0;
    var label = date.toLocaleString([], {
      weekday: 'long',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    }) + ' — ' + count.toLocaleString() + ' messages';

    pointMarkup += '<circle cx="' + x(index) +
      '" cy="' + y(count) +
      '" r="5" class="insight-chart-point" tabindex="0" role="button" aria-label="' +
      $('<div>').text(label).html() +
      '" data-label="' + $('<div>').text(label).html() + '"></circle>';
  });

  var yLines = '';
  for (var tick = 0; tick <= 4; tick++) { var value = Math.round(max * tick / 4), lineY = y(value); yLines += '<line x1="' + padding.left + '" y1="' + lineY + '" x2="' + (width - padding.right) + '" y2="' + lineY + '" stroke="#ddd" />'; yLines += '<text x="' + (padding.left - 8) + '" y="' + (lineY + 4) + '" text-anchor="end" font-size="11" fill="#777">' + value + '</text>'; }
  container.innerHTML = '<svg width="100%" height="' + height + '" viewBox="0 0 ' + width + ' ' + height + '" role="img" aria-label="Messages over time">' + yLines + '<line x1="' + padding.left + '" y1="' + (padding.top + plotHeight) + '" x2="' + (width - padding.right) + '" y2="' + (padding.top + plotHeight) + '" stroke="#999" /><polyline points="' + points + '" fill="none" stroke="#337ab7" stroke-width="3" />' + pointMarkup + labels + '</svg>';

  var tooltip = document.createElement('div');
  tooltip.className = 'insight-chart-tooltip';
  tooltip.setAttribute('role', 'status');
  container.appendChild(tooltip);

  function hideTooltip() {
    tooltip.style.display = 'none';
  }

  function showTooltip(point) {
    tooltip.textContent = point.getAttribute('data-label') || '';
    tooltip.style.display = 'block';

    var pointRect = point.getBoundingClientRect();
    var containerRect = container.getBoundingClientRect();
    var left = pointRect.left - containerRect.left + (pointRect.width / 2);
    var top = pointRect.top - containerRect.top - tooltip.offsetHeight - 8;

    left = Math.max(5, Math.min(left - (tooltip.offsetWidth / 2), containerRect.width - tooltip.offsetWidth - 5));
    if (top < 5) top = pointRect.bottom - containerRect.top + 8;

    tooltip.style.left = left + 'px';
    tooltip.style.top = top + 'px';
  }

  var chartPoints = container.querySelectorAll('.insight-chart-point');
  chartPoints.forEach(function (point) {
    point.addEventListener('mouseenter', function () {
      showTooltip(point);
    });

    point.addEventListener('mouseleave', hideTooltip);

    point.addEventListener('focus', function () {
      showTooltip(point);
    });

    point.addEventListener('blur', hideTooltip);

    point.addEventListener('click', function () {
      showTooltip(point);
    });
  });
}

function escapeInsightHtml(value) {
  return $('<div>').text(value == null ? '' : String(value)).html();
}

function renderLiveMessage(message, isNew) {
  var timestamp = Number(message.timestamp);
  var date = timestamp ? new Date(timestamp * 1000) : new Date();
  var time = date.toLocaleTimeString([], {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  });

  var agency = message.agency || 'UNKNOWN';
  var alias = message.alias || '';
  var address = message.address || '—';
  var source = message.source || '';

  var title = agency;
  if (alias) title += ' — ' + alias;

  var html = '<div class="insight-live-item' + (isNew ? ' new' : '') + '">' +
    '<div>' +
      '<span class="insight-live-time">' + escapeInsightHtml(time) + '</span>' +
      '<span class="insight-live-agency">' + escapeInsightHtml(title) + '</span>' +
      '<span class="insight-live-address">' + escapeInsightHtml(address) + '</span>' +
    '</div>' +
    '<div class="insight-live-message" title="' + escapeInsightHtml(message.message || '') + '">' +
      escapeInsightHtml(message.message || 'No message text') +
    '</div>' +
    (source ? '<div class="text-muted" style="font-size:11px;">' + escapeInsightHtml(source) + '</div>' : '') +
  '</div>';

  return html;
}

function addLiveInsightMessage(message) {
  var container = document.getElementById('insight-live-feed');
  if (!container) return;

  var waiting = container.querySelector('.text-muted.text-center');
  if (waiting) container.innerHTML = '';

  container.insertAdjacentHTML('afterbegin', renderLiveMessage(message, true));

  var items = container.querySelectorAll('.insight-live-item');
  for (var i = 30; i < items.length; i++) {
    items[i].remove();
  }

  window.setTimeout(function () {
    var first = container.querySelector('.insight-live-item');
    if (first) first.classList.remove('new');
  }, 1200);
}

function renderActivityHeatmap(activity) {
  var container = document.getElementById('insight-heatmap');
  var days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  var cells = [];
  var max = 0;
  var totals = {};
  (activity || []).forEach(function (point) {
    var date = new Date(Number(point.timestamp) * 1000);
    var key = date.getDay() + '-' + date.getHours();
    totals[key] = (totals[key] || 0) + (Number(point.count) || 0);
    max = Math.max(max, totals[key]);
  });
  var header = '<div class="heatmap-label"></div>';
  for (var hour = 0; hour < 24; hour++) header += '<div class="heatmap-hour">' + String(hour).padStart(2, '0') + '</div>';
  cells.push(header);
  for (var day = 0; day < 7; day++) {
    var row = '<div class="heatmap-label">' + days[day] + '</div>';
    for (var h = 0; h < 24; h++) {
      var count = totals[day + '-' + h] || 0;
      var level = max ? Math.min(4, Math.ceil((count / max) * 4)) : 0;
      var label = days[day] + ' ' + String(h).padStart(2, '0') + ':00 — ' + count.toLocaleString() + ' messages';
      row += '<div class="heatmap-cell" data-level="' + level + '" aria-label="' + label + '" title="' + label + '"></div>';
    }
    cells.push(row);
  }
  if (!activity || !activity.length) {
    container.innerHTML = '<div class="text-muted" style="grid-column:1 / -1;">No message activity for this period.</div>';
    return;
  }
  container.innerHTML = cells.join('');
}

function renderInsightTable(selector, rows, label, total) {
  var html = '';
  (rows || []).forEach(function (row) {
    var value = label(row);
    var count = Number(row.count || 0);
    var percent = total ? (count / total) * 100 : 0;
    var width = Math.max(percent, count ? 1 : 0);

    html += '<tr><td>' +
      $('<div>').text(value).html() +
      '<div class="insight-table-track"><span class="insight-table-bar" style="width:' +
      width + '%;"></span></div>' +
      '<div class="insight-table-percent">' +
      percent.toFixed(1) + '%</div>' +
      '</td><td class="text-right">' +
      count.toLocaleString() +
      '</td></tr>';
  });

  if (!html) html = '<tr><td colspan="2" class="text-muted">No data</td></tr>';
  $(selector).html(html);
}

function renderAgencyList(rows, total) {
  var html = '';
  (rows || []).forEach(function (row) {
    var count = Number(row.count || 0);
    var percent = total ? (count / total) * 100 : 0;
    var agency = row.agency || 'UNKNOWN';
    var width = Math.max(percent, count ? 1 : 0);
    html += '<div class="protocol-item"><div class="protocol-name">' +
      $('<div>').text(agency).html() +
      '<span class="protocol-meta">' + percent.toFixed(1) + '%</span></div>' +
      '<div class="protocol-track"><span class="protocol-bar" style="width:' +
      width + '%;"></span></div>' +
      '<div class="protocol-count">' + count.toLocaleString() +
      ' messages</div></div>';
  });
  if (!html) html = '<div class="protocol-item text-muted">No agency data</div>';
  $('#insight-agency-list').html(html);
}

function renderProtocolTable(rows, total) {
  var html = '';
  (rows || []).forEach(function (row) {
    var count = Number(row.count || 0);
    var percent = total ? (count / total) * 100 : 0;
    var protocol = row.protocol || 'UNKNOWN';
    var width = Math.max(percent, count ? 1 : 0);
    html += '<div class="protocol-item"><div class="protocol-name">' + $('<div>').text(protocol).html() + '<span class="protocol-meta">' + percent.toFixed(1) + '%</span></div><div class="protocol-track"><span class="protocol-bar" style="width:' + width + '%;"></span></div><div class="protocol-count">' + count.toLocaleString() + ' messages</div></div>';
  });
  if (!html) html = '<div class="protocol-item text-muted">No protocol data</div>';
  $('#insight-protocol-list').html(html);
}

function renderPeakActivity(peak) {
  if (!peak || !peak.timestamp) {
    $('#insight-peak-time').text('No activity');
    $('#insight-peak-count').text('0');
    $('#insight-average-hour').text('0');
    return;
  }

  var start = new Date(Number(peak.timestamp) * 1000);
  var end = new Date((Number(peak.timestamp) + 3600) * 1000);
  var day = start.toLocaleDateString([], { weekday: 'long' });
  var startTime = start.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  var endTime = end.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

  $('#insight-peak-time').text(day + ' ' + startTime + '–' + endTime);
  $('#insight-peak-count').text(Number(peak.count || 0).toLocaleString());
  $('#insight-average-hour').text(Number(peak.averagePerHour || 0).toLocaleString());
}

function renderLivePulse(pulse) {
  var count = Number(pulse && pulse.count || 0);
  var status = count > 0 ? 'active' : 'inactive';
  var label = count > 0 ? '🟢 Live Pulse' : '⚪ Live Pulse';

  if (count > 0 && count < 10) {
    status = 'quiet';
    label = '🟡 Live Pulse';
  }

  $('#insight-live-pulse-count').text(count.toLocaleString());
  $('#insight-live-pulse-label').text(label);
  $('.insight-live-pulse').removeClass('active quiet inactive').addClass(status);
}

function renderAnomaly(anomaly) {
  var data = anomaly || {};
  var status = data.status || 'normal';
  var current = Number(data.current || 0);
  var baseline = Number(data.baseline || 0);
  var percent = Number(data.percent || 0);

  var label = '🟢 Traffic Anomaly';
  var message = 'Traffic is within normal range';
  var detail = '';

  if (!data.sufficientData) {
    label = '⚪ Traffic Anomaly';
    message = 'Not enough traffic history';
    detail = 'At least three completed hourly periods are needed.';
    status = '';
  } else if (status === 'spike') {
    label = '🚨 Traffic Spike';
    message = 'Traffic is unusually high';
    detail = current.toLocaleString() + ' messages vs ' +
      baseline.toLocaleString() + ' typical per hour (' +
      (percent > 0 ? '+' : '') + percent.toFixed(1) + '%)';
  } else if (status === 'drop') {
    label = '🟡 Traffic Drop';
    message = 'Traffic is unusually quiet';
    detail = current.toLocaleString() + ' messages vs ' +
      baseline.toLocaleString() + ' typical per hour (' +
      percent.toFixed(1) + '%)';
  } else {
    detail = current.toLocaleString() + ' messages vs ' +
      baseline.toLocaleString() + ' typical per hour';
  }

  $('#insight-anomaly-label').text(label);
  $('#insight-anomaly-message').text(message);
  $('#insight-anomaly-detail').text(detail);
  $('.insight-anomaly').removeClass('normal spike drop').addClass(status);
}

function connectInsightLiveFeed() {
  var status = document.getElementById('insight-live-feed-status');

  if (typeof io !== 'function') {
    if (status) status.textContent = 'Unavailable';
    return;
  }

  var insightSocket = io({
    transports: ['websocket'],
    upgrade: false
  });

  insightSocket.on('connect', function () {
    if (status) {
      status.textContent = '🟢 LIVE';
      status.className = 'pull-right text-success insight-live-status';
    }
  });

  insightSocket.on('disconnect', function () {
    if (status) {
      status.textContent = '⚪ Disconnected';
      status.className = 'pull-right text-muted insight-live-status';
    }
  });

  insightSocket.on('connect_error', function () {
    if (status) {
      status.textContent = '🔴 Connection error';
      status.className = 'pull-right text-danger insight-live-status';
    }
  });

  insightSocket.on('messagePost', function (message) {
    addLiveInsightMessage(message);
  });

  return insightSocket;
}

function loadInsights() {
  var range = insightRange();
  $.getJSON('/api/insights?start=' + range.start + '&end=' + range.end)
    .done(function (data) {
      $('#insight-messages').text(data.messages.toLocaleString());
      $('#insight-addresses').text(data.uniqueAddresses.toLocaleString());
      $('#insight-capcodes').text(data.uniqueCapcodes.toLocaleString());
      $('#insight-source').text(data.topAgencies.length ? data.topAgencies[0].agency || 'UNKNOWN' : 'UNKNOWN');
      renderLivePulse(data.livePulse);
      renderAnomaly(data.anomaly);
      renderInsightChart(data.activity);
      renderPeakActivity(data.peakActivity);
      renderActivityHeatmap(data.activity);
      renderTrends(data.trends);
      renderAgencyList(data.topAgencies, data.messages);
      renderProtocolTable(data.topProtocols, data.messages);
      renderInsightTable('#insight-address-table', data.topAddresses, function (row) { return row.address || '—'; }, data.messages);
      renderInsightTable('#insight-capcode-table', data.topCapcodes, function (row) { return row.alias || row.address || '—'; }, data.messages);
      renderInsightTable('#insight-source-table', data.topAgencies, function (row) { return row.agency || 'UNKNOWN'; });
      $('#insight-error').hide();
    })
    .fail(function (xhr) { var message = 'Unable to load Insights.'; if (xhr.responseJSON && xhr.responseJSON.error) message = xhr.responseJSON.error; $('#insight-error').text(message).show(); });
}

$(function () {
  $('.insight-range').on('click', function () {
    insightCustomRange = null;
    insightDays = Number($(this).data('days'));
    $('.insight-range').removeClass('active');
    $(this).addClass('active');
    $('#insight-custom').hide();
    loadInsights();
  });

  $('#insight-custom-toggle').on('click', function () {
    $('#insight-custom').toggle();
    if ($('#insight-custom').is(':visible')) {
      var range = insightRange();
      $('#insight-start').val(toDateTimeLocal(range.start));
      $('#insight-end').val(toDateTimeLocal(range.end));
    }
  });

  $('#insight-custom-form').on('submit', function (event) {
    event.preventDefault();
    var start = new Date($('#insight-start').val()).getTime() / 1000;
    var end = new Date($('#insight-end').val()).getTime() / 1000;
    if (!isFinite(start) || !isFinite(end) || end <= start) {
      $('#insight-error').text('Please select a valid date range.').show();
      return;
    }
    insightCustomRange = { start: Math.floor(start), end: Math.floor(end) };
    $('.insight-range').removeClass('active');
    loadInsights();
  });

  $('.insight-range[data-days="1"]').addClass('active');
  connectInsightLiveFeed();
  loadInsights();
});
</script>
</body>
</html>
